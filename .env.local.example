NEXT_PUBLIC_SANITY_PROJECT_ID=i4t9kzxg
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
SANITY_API_TOKEN=
# Server-only token with write access: Razorpay webhook orders + /admin saves
SANITY_API_WRITE_TOKEN=
# Header secret for the Sanity → /api/ship-notify webhook
SANITY_WEBHOOK_SECRET=
# Header secret for the Sanity → /api/revalidate webhook
SANITY_REVALIDATE_SECRET=

# Shop on/off switch ("true" to take orders)
NEXT_PUBLIC_COMMERCE_ENABLED=
# Razorpay API keys (rzp_test_… locally, rzp_live_… in production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret set on the Razorpay dashboard webhook (payment.captured)
RAZORPAY_WEBHOOK_SECRET=

RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. Mandakini Rao <orders@mandakinirao.com>
EMAIL_FROM=
# Where new-order and enquiry notifications go
MANDAKINI_ORDER_EMAIL=

# Comma-separated — CSRF origin allowlist for mutating API routes
# (checkout, enquiry). Add a Vercel preview/alias domain here too if it
# needs to work, e.g.: https://mandakinirao.com,https://mandakini-website.vercel.app
NEXT_PUBLIC_SITE_URL=https://mandakinirao.com
ADMIN_EMAIL=

# /admin login password
ADMIN_PASSWORD=
# 32+ random chars; signs the /admin session cookie. Rotating it logs everyone out.
ADMIN_SESSION_SECRET=
